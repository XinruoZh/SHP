// SHP — nextflow.config
// All pipeline parameters with defaults.
// Use -profile docker to run with Docker; default uses local conda env.

params {
    // Input (required for full pipeline)
    allele_search_dir = null       // Path to allele_search blast_summary_filtered/ directory
    genome_dir        = null       // Directory with genome FASTA files
    code_dir          = "${projectDir}/code"

    // Output
    outdir = "${projectDir}/results"

    // Region definition (required; both measured in bp from gene end)
    region_start = null            // bp offset for window start (can be negative)
    region_end   = null            // bp offset for window end   (can be negative)
    strand_mode  = 'both'          // same_strand | other_strand | both

    // ORF finding
    min_orf_length = 30            // minimum ORF length in bp (default 10 aa)
    max_orf_length = null          // maximum ORF length in bp, excluding stop codon (optional)
    start_codons   = 'ATG,GTG,TTG' // comma-separated start codons; ATG is preferred when present
    batch_size         = 100       // region FASTAs processed per FIND_ORFS task
    extract_batch_size = 100       // genomes per EXTRACT_DOWNSTREAM_REGION task

    // CD-HIT clustering
    cdhit_identity = 0.9           // sequence identity threshold
    cdhit_length   = 0.9           // min alignment/length ratio (applied to both aL and aS)

    // HMMER search (step 3.5, optional)
    hmmer_query                = null   // path to query file (.faa/.fasta for phmmer/jackhmmer/hmmsearch, or .hmm for hmmsearch)
    hmmer_tool                 = 'phmmer' // phmmer | jackhmmer | hmmsearch
    hmmer_evalue               = 10.0   // reporting E-value threshold (-E)
    hmmer_incE                 = 0.001  // inclusion E-value threshold (--incE)
    hmmer_N                    = 5      // jackhmmer max iterations (-N)
    hmmer_cpu                  = 2      // CPU threads (--cpu)
    hmmer_use_original_alignment = false // skip hmmalign re-alignment when building HMM from FASTA

    // Step modes (mutually exclusive; run full pipeline if none set)
    step    = null
    extract = false
    cluster = false
    help    = false
}

// Profiles
profiles {

    standard {
        // Local conda environment fallback
        process.beforeScript = 'export PATH=/home/xinruoz/miniconda3/envs/shp/bin:$PATH'
    }

    docker {
        docker.enabled = true
        // Mount the entire home directory so symlinks in genome_dir / allele_search_dir
        // that point to paths outside projectDir are still accessible inside the container.
        def home = System.getProperty('user.home')
        docker.runOptions = "-u \$(id -u):\$(id -g) -v ${home}:${home}"
        process.container = 'shp:latest'
    }

}

// Resource defaults
process {
    withName: 'CD_HIT_CLUSTER' {
        cpus   = 4
        memory = '2 GB'
    }
    withName: 'HMMER_SEARCH' {
        cpus   = { params.hmmer_cpu as int }
        memory = '1 GB'
    }
}

// Reports
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/timeline.html"
}

report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/report.html"
}
